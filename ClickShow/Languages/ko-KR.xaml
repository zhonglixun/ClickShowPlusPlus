<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="appSettingsTitle">설정</sys:String>
    <sys:String x:Key="secConfig">프로필</sys:String>
    <sys:String x:Key="followSystem">시스템 따르기</sys:String>
    <sys:String x:Key="alwaysLight">항상 라이트</sys:String>
    <sys:String x:Key="alwaysDark">항상 다크</sys:String>
    <sys:String x:Key="editingLabel">편집 중</sys:String>
    <sys:String x:Key="editLight">라이트 프로필</sys:String>
