<Window
    x:Class="ClickShow.CaptureOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CaptureOverlay"
    AllowsTransparency="True"
    Background="#22000000"
    Cursor="Cross"
    ShowActivated="True"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None"
    PreviewKeyDown="Window_PreviewKeyDown"
    MouseDown="Overlay_MouseDown"
    WindowStartupLocation="Manual">
    <Grid>
        <Border
            Padding="16,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,40,0,0"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Accent}"
            BorderThickness="1"
            CornerRadius="8">
            <TextBlock Foreground="{DynamicResource TextPrimary}" Style="{StaticResource HintText}" Text="{DynamicResource captureHint}" />
        </Border>
    </Grid>
</Window>
