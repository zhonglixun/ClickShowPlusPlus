<Window
    x:Class="ClickShow.ClickIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ClickShow"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="点击查看器"
    Width="150"
    Height="150"
    x:Name="IndicatorWindow"
    AllowsTransparency="True"
    Background="Transparent"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid>
        <Ellipse
            x:Name="TheCircle"
            Width="{Binding Width, ElementName=IndicatorWindow}"
            Height="{Binding Height, ElementName=IndicatorWindow}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RenderTransformOrigin="0.5,0.5"
            Stroke="Blue"
            StrokeThickness="3">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="CircleScale" ScaleX="0.2" ScaleY="0.2" />
            </Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</Window>
