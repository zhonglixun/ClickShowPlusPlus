<Window
    x:Class="ClickShow.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utility="clr-namespace:ClickShow.Utility"
    Title="ClickShow++"
    Icon="/clickshow.ico"
    Width="980" Height="820" MinWidth="900" MinHeight="620"
    Background="{DynamicResource Bg}"
    PreviewKeyDown="Window_PreviewKeyDown"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <utility:StringToBrushConverter x:Key="StringToBrush" />
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Height="32" Padding="9,0" Background="Transparent" CornerRadius="7">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ChipBg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Padding="9,5" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ChipBg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PresetChip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Padding="7,4" Background="Transparent" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="14">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ChipBg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SmallHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="KeyHex" BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
            <Setter Property="Width" Value="82" />
            <Setter Property="Height" Value="20" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="13,11" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
            <Grid Margin="10,14,10,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="6,0,6,16" Orientation="Horizontal">
                    <Image Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" Source="/clickshow.ico" />
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="ClickShow++" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource secRipple}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="1" Margin="8,0,0,6" FontSize="10" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource settingsTitle}" />
                <StackPanel Grid.Row="2">
                    <RadioButton x:Name="NavAppearance" Margin="0,1" Checked="Nav_Checked" GroupName="Nav" IsChecked="True" Style="{StaticResource NavItem}" Tag="Appearance">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Margin="0,0,8,0" Data="M8,1.5A6.5,6.5 0 1,0 14.5,8A6.5,6.5 0 0,0 8,1.5M8,4A4,4 0 1,1 4,8A4,4 0 0,1 8,4M8,6.5A1.5,1.5 0 1,0 9.5,8A1.5,1.5 0 0,0 8,6.5Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" />
                            <TextBlock Text="{DynamicResource navAppearance}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSilence" Margin="0,1" Checked="Nav_Checked" GroupName="Nav" Style="{StaticResource NavItem}" Tag="Silence">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Margin="0,0,8,0" Data="M4,9V15H8L13,20V4L8,9H4M16.5,12A4.5,4.5 0 0,0 14,7.97V16.02A4.47,4.47 0 0,0 16.5,12M19,12A7,7 0 0,1 12.5,18.9V21A9,9 0 0,0 21,12A9,9 0 0,0 12.5,3V5.1A7,7 0 0,1 19,12Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" />
                            <TextBlock Text="{DynamicResource secSilence}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavGeneral" Margin="0,1" Checked="Nav_Checked" GroupName="Nav" Style="{StaticResource NavItem}" Tag="General">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Margin="0,0,8,0" Data="M8,5.5A2.5,2.5 0 1,0 10.5,8A2.5,2.5 0 0,0 8,5.5M13.2,8.7C13.2,8.5 13.3,8.2 13.3,8C13.3,7.8 13.2,7.5 13.2,7.3L14.7,6.1L13.3,3.7L11.5,4.4C11.1,4.1 10.6,3.9 10.1,3.7L9.8,1.8H6.2L5.9,3.7C5.4,3.9 4.9,4.1 4.5,4.4L2.7,3.7L1.3,6.1L2.8,7.3C2.8,7.5 2.7,7.8 2.7,8C2.7,8.2 2.8,8.5 2.8,8.7L1.3,9.9L2.7,12.3L4.5,11.6C4.9,11.9 5.4,12.1 5.9,12.3L6.2,14.2H9.8L10.1,12.3C10.6,12.1 11.1,11.9 11.5,11.6L13.3,12.3L14.7,9.9L13.2,8.7Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" />
                            <TextBlock Text="{DynamicResource secGeneral}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <StackPanel Grid.Row="4">
                    <Border Padding="8,7" Background="{DynamicResource ChipBg}" CornerRadius="7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="12" Height="12" Margin="0,0,7,0" Data="M5,3H8V13H5V3M10,3H13V13H10V3Z" Fill="{DynamicResource TextSecondary}" Stretch="Uniform" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource showRipples}" />
                            <CheckBox x:Name="RipplesSwitch" Grid.Column="2" Checked="RipplesSwitch_Changed" Unchecked="RipplesSwitch_Changed" Style="{StaticResource SwitchCheckBox}" />
                        </Grid>
                    </Border>
                    <Border Margin="0,6,0,0" Padding="8,7" Background="{DynamicResource ChipBg}" CornerRadius="7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="11" Height="11" Margin="0,0,7,0" Fill="{DynamicResource Accent}" Opacity="0.55" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource secHoverDot}" />
                            <CheckBox Grid.Column="2" IsChecked="{Binding Editing.EnableHoverDot, Mode=TwoWay}" Style="{StaticResource SwitchCheckBox}" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="SidebarVersion" Margin="8,8,0,0" FontSize="10" Foreground="{DynamicResource TextSecondary}" Text="v2.1.0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid x:Name="AppearancePage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,18,22,8">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource navAppearance}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource SmallHint}" Text="{DynamicResource appearanceHint}" />
                            </StackPanel>
                            <Border Grid.Column="1" Padding="9,4" VerticalAlignment="Top" Background="{DynamicResource ChipBg}" CornerRadius="12">
                                <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource followSystem}" />
                            </Border>
                        </Grid>

                        <Border Margin="0,0,0,10" Padding="13,10" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                    <TextBlock Width="76" VerticalAlignment="Center" Style="{StaticResource SmallHint}" Text="{DynamicResource secConfig}" />
                                    <Border Padding="2" Background="{DynamicResource ChipBg}" CornerRadius="8">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ModeSystemRadio" MinWidth="64" Checked="ModeRadio_Checked" Content="{DynamicResource followSystem}" GroupName="Mode" IsChecked="True" Style="{StaticResource SegItem}" Tag="System" />
                                            <RadioButton x:Name="ModeLightRadio" MinWidth="64" Checked="ModeRadio_Checked" Content="{DynamicResource alwaysLight}" GroupName="Mode" Style="{StaticResource SegItem}" Tag="Light" />
                                            <RadioButton x:Name="ModeDarkRadio" MinWidth="64" Checked="ModeRadio_Checked" Content="{DynamicResource alwaysDark}" GroupName="Mode" Style="{StaticResource SegItem}" Tag="Dark" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="76" VerticalAlignment="Center" Style="{StaticResource SmallHint}" Text="{DynamicResource editingLabel}" />
                                    <Border Padding="2" Background="{DynamicResource ChipBg}" CornerRadius="8">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="EditLightRadio" MinWidth="72" Checked="EditRadio_Checked" Content="{DynamicResource editLight}" GroupName="Edit" IsChecked="True" Style="{StaticResource SegItem}" Tag="Light" />
                                            <RadioButton x:Name="EditDarkRadio" MinWidth="72" Checked="EditRadio_Checked" Content="{DynamicResource editDark}" GroupName="Edit" Style="{StaticResource SegItem}" Tag="Dark" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,7">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource previewLightHint}" />
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource SmallHint}" Text="{DynamicResource previewDarkHint}" />
                                </Grid>
                                <Border Height="96" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" ClipToBounds="True" CornerRadius="8">
                                    <Grid x:Name="PreviewArea" Background="Transparent" Cursor="Cross" MouseDown="PreviewArea_MouseDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#FFFFFF" />
                                        <Border Grid.Column="1" Background="#0F1013" />
                                        <Canvas x:Name="PreviewCanvas" Grid.ColumnSpan="2" Background="Transparent" ClipToBounds="True" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel DataContext="{Binding Editing}">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SmallHint}" Text="{DynamicResource rippleSize}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" Margin="8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="7" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="5*" />
                                            <ColumnDefinition Width="7" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.ColumnSpan="4" IsSnapToTickEnabled="True" Maximum="400" Minimum="50" Style="{StaticResource ModernSlider}" TickFrequency="5" Value="{Binding IndicatorSize}" />
                                        <Rectangle Grid.Column="1" Width="2" Height="5" Margin="0,0,-1,-6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource TextSecondary}" IsHitTestVisible="False" Opacity="0.7" />
                                    </Grid>
                                    <TextBlock Grid.Column="2" TextAlignment="Right" Style="{StaticResource SmallHint}" Text="{Binding IndicatorSize, StringFormat={}{0:0} px}" />
                                </Grid>
                                <Grid Margin="0,4,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SmallHint}" Text="{DynamicResource rippleDuration}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" Margin="8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="7" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="7" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.ColumnSpan="4" IsSnapToTickEnabled="True" Maximum="600" Minimum="200" Style="{StaticResource ModernSlider}" TickFrequency="25" Value="{Binding RippleDurationMs}" />
                                        <Rectangle Grid.Column="1" Width="2" Height="5" Margin="0,0,-1,-6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource TextSecondary}" IsHitTestVisible="False" Opacity="0.7" />
                                    </Grid>
                                    <TextBlock Grid.Column="2" TextAlignment="Right" Style="{StaticResource SmallHint}" Text="{Binding RippleDurationMs, StringFormat={}{0:0} ms}" />
                                </Grid>
                                <TextBlock Margin="0,8,0,4" Style="{StaticResource SmallHint}" Text="{DynamicResource easingStyle}" />
                                <Border Padding="2" Background="{DynamicResource ChipBg}" CornerRadius="8">
                                    <UniformGrid Columns="5" Rows="1">
                                        <RadioButton x:Name="EasingLinear" Checked="EasingRadio_Checked" Content="{DynamicResource easingLinear}" GroupName="Easing" IsChecked="True" Style="{StaticResource SegItem}" Tag="Linear" />
                                        <RadioButton x:Name="EasingCubic" Checked="EasingRadio_Checked" Content="{DynamicResource easingDecel}" GroupName="Easing" Style="{StaticResource SegItem}" Tag="CubicOut" />
                                        <RadioButton x:Name="EasingExpo" Checked="EasingRadio_Checked" Content="{DynamicResource easingExpo}" GroupName="Easing" Style="{StaticResource SegItem}" Tag="ExponentialOut" />
                                        <RadioButton x:Name="EasingBack" Checked="EasingRadio_Checked" Content="{DynamicResource easingBack}" GroupName="Easing" Style="{StaticResource SegItem}" Tag="BackOut" />
                                        <RadioButton x:Name="EasingElastic" Checked="EasingRadio_Checked" Content="{DynamicResource easingElastic}" GroupName="Easing" Style="{StaticResource SegItem}" Tag="ElasticOut" />
                                    </UniformGrid>
                                </Border>
                                <TextBlock Margin="0,8,0,4" Style="{StaticResource SmallHint}" Text="{DynamicResource presetTheme}" />
                                <WrapPanel>
                                    <RadioButton x:Name="PresetClassic" Checked="PresetRadio_Checked" GroupName="Preset" IsChecked="True" Style="{StaticResource PresetChip}" Tag="Classic">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Margin="0,0,5,0" Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#3B82F6" /><Ellipse Margin="-2,0,0,0" Width="7" Height="7" Fill="#22C55E" /><Ellipse Margin="-2,0,0,0" Width="7" Height="7" Fill="#F97316" /></StackPanel>
                                            <TextBlock Text="{DynamicResource presetClassic}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="PresetNeon" Checked="PresetRadio_Checked" GroupName="Preset" Style="{StaticResource PresetChip}" Tag="Neon">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Margin="0,0,5,0" Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#39FF14" /><Ellipse Margin="-2,0,0,0" Width="7" Height="7" Fill="#FF2D95" /><Ellipse Margin="-2,0,0,0" Width="7" Height="7" Fill="#00E5FF" /></StackPanel>
                                            <TextBlock Text="{DynamicResource presetNeon}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="PresetCandy" Checked="PresetRadio_Checked" GroupName="Preset" Style="{StaticResource PresetChip}" Tag="Candy">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Margin="0,0,5,0" Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#FF6B9D" /><Ellipse Margin="-2,0,0,0" Width="7" Height="7" Fill="#4ECDC4" /><Ellipse Margin="-2,0,0,0" Width="7" Height="7" Fill="#FFD166" /></StackPanel>
                                            <TextBlock Text="{DynamicResource presetCandy}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="PresetOcean" Checked="PresetRadio_Checked" GroupName="Preset" Style="{StaticResource PresetChip}" Tag="Ocean">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Margin="0,0,5,0" Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#0077B6" /><Ellipse Margin="-2,0,0,0" Width="7" Height="7" Fill="#00B4D8" /><Ellipse Margin="-2,0,0,0" Width="7" Height="7" Fill="#48CAE4" /></StackPanel>
                                            <TextBlock Text="{DynamicResource presetOcean}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="PresetSunset" Checked="PresetRadio_Checked" GroupName="Preset" Style="{StaticResource PresetChip}" Tag="Sunset">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Margin="0,0,5,0" Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#FF5E5B" /><Ellipse Margin="-2,0,0,0" Width="7" Height="7" Fill="#FF9F1C" /><Ellipse Margin="-2,0,0,0" Width="7" Height="7" Fill="#FFD166" /></StackPanel>
                                            <TextBlock Text="{DynamicResource presetSunset}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="PresetCustom" Checked="PresetRadio_Checked" GroupName="Preset" Style="{StaticResource PresetChip}" Tag="Custom">
                                        <TextBlock Text="{DynamicResource presetCustom}" />
                                    </RadioButton>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel DataContext="{Binding Editing}">
                                <TextBlock Margin="0,0,0,6" Style="{StaticResource CardTitle}" Text="{DynamicResource secHoverDot}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                        <Grid><TextBlock FontSize="11.5" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource tileLeft}" /><CheckBox HorizontalAlignment="Right" IsChecked="{Binding MouseButtonSettings[Left].IsEnabled}" Style="{StaticResource SwitchCheckBox}" /></Grid>
                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal"><Button Width="18" Height="18" Background="{Binding MouseButtonSettings[Left].Color, Converter={StaticResource StringToBrush}}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Click="Swatch_Click" Cursor="Hand" Tag="Left" ToolTip="{DynamicResource swatchLeftTip}" /><TextBox x:Name="HexLeft" Margin="6,0,0,0" KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus" Style="{StaticResource KeyHex}" Tag="Left" TextChanged="HexBox_TextChanged" /></StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                        <Grid><TextBlock FontSize="11.5" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource tileMiddle}" /><CheckBox HorizontalAlignment="Right" IsChecked="{Binding MouseButtonSettings[Middle].IsEnabled}" Style="{StaticResource SwitchCheckBox}" /></Grid>
                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal"><Button Width="18" Height="18" Background="{Binding MouseButtonSettings[Middle].Color, Converter={StaticResource StringToBrush}}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Click="Swatch_Click" Cursor="Hand" Tag="Middle" ToolTip="{DynamicResource swatchMiddleTip}" /><TextBox x:Name="HexMiddle" Margin="6,0,0,0" KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus" Style="{StaticResource KeyHex}" Tag="Middle" TextChanged="HexBox_TextChanged" /></StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                        <Grid><TextBlock FontSize="11.5" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource tileRight}" /><CheckBox HorizontalAlignment="Right" IsChecked="{Binding MouseButtonSettings[Right].IsEnabled}" Style="{StaticResource SwitchCheckBox}" /></Grid>
                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal"><Button Width="18" Height="18" Background="{Binding MouseButtonSettings[Right].Color, Converter={StaticResource StringToBrush}}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Click="Swatch_Click" Cursor="Hand" Tag="Right" ToolTip="{DynamicResource swatchRightTip}" /><TextBox x:Name="HexRight" Margin="6,0,0,0" KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus" Style="{StaticResource KeyHex}" Tag="Right" TextChanged="HexBox_TextChanged" /></StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                        <Grid><TextBlock FontSize="11.5" Foreground="{DynamicResource TextPrimary}" Text="X1" /><CheckBox HorizontalAlignment="Right" IsChecked="{Binding MouseButtonSettings[XButton1].IsEnabled}" Style="{StaticResource SwitchCheckBox}" /></Grid>
                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal"><Button Width="18" Height="18" Background="{Binding MouseButtonSettings[XButton1].Color, Converter={StaticResource StringToBrush}}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Click="Swatch_Click" Cursor="Hand" Tag="XButton1" ToolTip="{DynamicResource swatchX1Tip}" /><TextBox x:Name="HexX1" Margin="6,0,0,0" KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus" Style="{StaticResource KeyHex}" Tag="XButton1" TextChanged="HexBox_TextChanged" /></StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <Grid><TextBlock FontSize="11.5" Foreground="{DynamicResource TextPrimary}" Text="X2" /><CheckBox HorizontalAlignment="Right" IsChecked="{Binding MouseButtonSettings[XButton2].IsEnabled}" Style="{StaticResource SwitchCheckBox}" /></Grid>
                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal"><Button Width="18" Height="18" Background="{Binding MouseButtonSettings[XButton2].Color, Converter={StaticResource StringToBrush}}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Click="Swatch_Click" Cursor="Hand" Tag="XButton2" ToolTip="{DynamicResource swatchX2Tip}" /><TextBox x:Name="HexX2" Margin="6,0,0,0" KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus" Style="{StaticResource KeyHex}" Tag="XButton2" TextChanged="HexBox_TextChanged" /></StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <Grid><TextBlock FontSize="11.5" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource secHoverDot}" /><CheckBox HorizontalAlignment="Right" IsChecked="{Binding EnableHoverDot}" Style="{StaticResource SwitchCheckBox}" /></Grid>
                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal"><Button Width="18" Height="18" Background="{Binding HoverDotFill, Converter={StaticResource StringToBrush}}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Click="Swatch_Click" Cursor="Hand" Tag="HoverDotFill" ToolTip="{DynamicResource swatchDotTip}" /><TextBox x:Name="HexDot" Margin="6,0,0,0" KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus" Style="{StaticResource KeyHex}" Tag="HoverDotFill" TextChanged="HexBox_TextChanged" /></StackPanel>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SmallHint}" Text="{DynamicResource hoverDotSize}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" Margin="8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="7" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="7*" />
                                            <ColumnDefinition Width="7" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.ColumnSpan="4" IsSnapToTickEnabled="True" Maximum="200" Minimum="20" Style="{StaticResource ModernSlider}" TickFrequency="5" Value="{Binding HoverDotSize}" />
                                        <Rectangle Grid.Column="1" Width="2" Height="5" Margin="0,0,-1,-6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource TextSecondary}" IsHitTestVisible="False" Opacity="0.7" />
                                    </Grid>
                                    <TextBlock Grid.Column="2" TextAlignment="Right" Style="{StaticResource SmallHint}" Text="{Binding HoverDotSize, StringFormat={}{0:0} px}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="1" Margin="22,4,22,12">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SmallHint}" Text="{DynamicResource captureHint}" Visibility="Collapsed" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Click="ResetDefault_Click" Content="{DynamicResource resetButton}" Style="{StaticResource GhostButton}" />
                        <Button Margin="8,0,0,0" Click="Export_Click" Content="{DynamicResource exportButton}" Style="{StaticResource GhostButton}" />
                        <Button Margin="8,0,0,0" Click="Close_Click" Content="{DynamicResource closeButton}" Style="{StaticResource GhostButton}" />
                    </StackPanel>
                </Grid>
            </Grid>
            <Grid x:Name="SilencePage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,18,22,8">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource secSilence}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource SmallHint}" Text="{DynamicResource silenceMasterHint}" />
                            </StackPanel>
                            <Border Grid.Column="1" Padding="9,4" VerticalAlignment="Top" Background="{DynamicResource AccentSoft}" CornerRadius="12">
                                <TextBlock FontSize="10" Foreground="{DynamicResource Accent}" Text="{DynamicResource enableSilence}" />
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource enableSilence}" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource SmallHint}" Text="{DynamicResource silenceMasterHint}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Setting.SilenceEnabled}" Style="{StaticResource SwitchCheckBox}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource fullscreenHide}" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource SmallHint}" Text="{DynamicResource fullscreenHideHint}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Setting.FullscreenHide}" Style="{StaticResource SwitchCheckBox}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource processSilence}" />
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource SmallHint}" Text="{DynamicResource processSilenceHint}" />
                                </Grid>
                                <ItemsControl Margin="0,2,0,0" ItemsSource="{Binding ProcessList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,6,6" Padding="9,4" Background="{DynamicResource ChipBg}" BorderBrush="{DynamicResource ChipBorder}" BorderThickness="1" CornerRadius="14">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextPrimary}" Text="{Binding}" />
                                                    <Button Margin="6,0,0,0" Click="ChipRemove_Click" Style="{StaticResource ChipCloseButton}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBox x:Name="AddProcessBox" Width="220" Height="28" KeyDown="AddProcessBox_KeyDown" Style="{StaticResource TextInput}" />
                                    <Button Margin="8,0,0,0" Click="AddProcess_Click" Content="{DynamicResource addButton}" Style="{StaticResource GhostButton}" />
                                    <Button Margin="8,0,0,0" Click="BrowseProcess_Click" Content="{DynamicResource browseButton}" Style="{StaticResource GhostButton}" />
                                    <Button x:Name="CaptureButton" Margin="8,0,0,0" Click="CaptureForeground_Click" Content="{DynamicResource captureStart}" Style="{StaticResource GhostButton}" ToolTip="{DynamicResource captureHint}" />
                                </StackPanel>
                                <TextBlock x:Name="CaptureHint" Margin="0,8,0,0" Foreground="{DynamicResource Danger}" Style="{StaticResource SmallHint}" Text="{DynamicResource captureHint}" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="1" Margin="22,4,22,12">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SmallHint}" Text="{DynamicResource silenceMasterHint}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Click="ResetDefault_Click" Content="{DynamicResource resetButton}" Style="{StaticResource GhostButton}" />
                        <Button Margin="8,0,0,0" Click="Close_Click" Content="{DynamicResource closeButton}" Style="{StaticResource GhostButton}" />
                    </StackPanel>
                </Grid>
            </Grid>
            <Grid x:Name="GeneralPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,18,22,8">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource secGeneral}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource SmallHint}" Text="{DynamicResource generalHint}" />
                            </StackPanel>
                            <Border Grid.Column="1" Padding="9,4" VerticalAlignment="Top" Background="{DynamicResource ChipBg}" CornerRadius="12">
                                <TextBlock x:Name="VersionPill" FontSize="10" Foreground="{DynamicResource TextSecondary}" Text="ClickShow++ 2.1.0" />
                            </Border>
                        </Grid>

                        <Border x:Name="UpdateCard" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="UpdateTitle" Style="{StaticResource CardTitle}" Text="ClickShow++ 2.1.0" />
                                    <TextBlock x:Name="UpdateSub" Margin="0,2,0,0" Style="{StaticResource SmallHint}" Text="{DynamicResource updateCheck}" />
                                    <ProgressBar x:Name="UpdateProgress" Height="4" Margin="0,8,0,0" Maximum="100" Visibility="Collapsed" />
                                </StackPanel>
                                <Button x:Name="UpdateButton" Grid.Column="1" MinWidth="88" VerticalAlignment="Center" Click="CheckUpdate_Click" Content="{DynamicResource updateCheck}" Style="{StaticResource GhostButton}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource autoStartLabel}" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource SmallHint}" Text="{DynamicResource autoStartHint}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding AutoStart}" Style="{StaticResource SwitchCheckBox}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource languageLabel}" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource SmallHint}" Text="{DynamicResource languageHint}" />
                                </StackPanel>
                                <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="180" Height="28" VerticalAlignment="Center" FontSize="11.5" SelectionChanged="LanguageCombo_SelectionChanged" VerticalContentAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,6" Style="{StaticResource CardTitle}" Text="{DynamicResource configTitle}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Click="Export_Click" Content="{DynamicResource exportButton}" Style="{StaticResource GhostButton}" />
                                    <Button Margin="8,0,0,0" Click="Import_Click" Content="{DynamicResource importButton}" Style="{StaticResource GhostButton}" />
                                    <Button Margin="8,0,0,0" Click="ResetDefault_Click" Content="{DynamicResource resetButton}" Style="{StaticResource GhostButton}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,6" Style="{StaticResource CardTitle}" Text="ClickShow++" />
                                <Grid Margin="0,2,0,0">
                                    <TextBlock Style="{StaticResource SmallHint}" Text="Windows 10 1809+ / 11 (x64)" />
                                    <TextBlock x:Name="VersionText" HorizontalAlignment="Right" Style="{StaticResource SmallHint}" Text="v2.1.0" />
                                </Grid>
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource SmallHint}">
                                    <Hyperlink Click="OpenRepo_Click" Foreground="{DynamicResource Accent}" TextDecorations="None">github.com/zhonglixun/ClickShowPlusPlus</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="1" Margin="22,4,22,12">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SmallHint}" Text="{DynamicResource generalHint}" />
                    <Button HorizontalAlignment="Right" Click="Close_Click" Content="{DynamicResource closeButton}" Style="{StaticResource GhostButton}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
