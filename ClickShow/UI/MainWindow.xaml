<Window
    x:Class="ClickShow.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ClickShow"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utility="clr-namespace:ClickShow.Utility"
    Title="ClickShow"
    Width="580"
    SizeToContent="Height"
    Background="{DynamicResource Bg}"
    MinHeight="400"
    PreviewKeyDown="Window_PreviewKeyDown"
    ResizeMode="CanMinimize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <utility:StringToBrushConverter x:Key="StringToBrush" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,12,18,18">

            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource secConfig}" />
            <WrapPanel Orientation="Horizontal">
                <RadioButton x:Name="ModeSystemRadio" Checked="ModeRadio_Checked" Content="{DynamicResource followSystem}" GroupName="Mode" IsChecked="True" Style="{StaticResource PillRadio}" Tag="System" />
                <RadioButton x:Name="ModeLightRadio" Margin="8,0,0,0" Checked="ModeRadio_Checked" Content="{DynamicResource alwaysLight}" GroupName="Mode" Style="{StaticResource PillRadio}" Tag="Light" />
                <RadioButton x:Name="ModeDarkRadio" Margin="8,0,0,0" Checked="ModeRadio_Checked" Content="{DynamicResource alwaysDark}" GroupName="Mode" Style="{StaticResource PillRadio}" Tag="Dark" />
            </WrapPanel>
            <WrapPanel Margin="0,10,0,0" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource editingLabel}" />
                <RadioButton x:Name="EditLightRadio" Margin="10,0,0,0" Checked="EditRadio_Checked" Content="{DynamicResource editLight}" GroupName="Edit" IsChecked="True" Style="{StaticResource PillRadio}" Tag="Light" />
                <RadioButton x:Name="EditDarkRadio" Margin="8,0,0,0" Checked="EditRadio_Checked" Content="{DynamicResource editDark}" GroupName="Edit" Style="{StaticResource PillRadio}" Tag="Dark" />
                <TextBlock MaxWidth="300" Margin="12,0,0,0" Style="{StaticResource HintText}" Text="{DynamicResource editingHint}" />
            </WrapPanel>
            <Separator Margin="0,14" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="{DynamicResource secRipple}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" Style="{StaticResource HintText}" Text="{DynamicResource enableLabel}" />
                    <CheckBox IsChecked="{Binding Editing.EnableClickCircle}" Style="{StaticResource SwitchCheckBox}" />
                </StackPanel>
            </Grid>
            <Border Height="170" Style="{StaticResource Card}">
                <Grid x:Name="PreviewArea" Background="Transparent" ClipToBounds="True" Cursor="Cross" MouseDown="PreviewArea_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FFFFFF" />
                    <Border Grid.Column="1" Background="#101114" />
                    <TextBlock Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Style="{StaticResource HintText}" Foreground="#9AA0AA" Text="{DynamicResource previewLightHint}" />
                    <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Style="{StaticResource HintText}" Foreground="#6B7280" Text="{DynamicResource previewDarkHint}" />
                    <Canvas x:Name="PreviewCanvas" Grid.ColumnSpan="2" Background="Transparent" ClipToBounds="True" />
                </Grid>
            </Border>
            <Grid Margin="0,10,0,0" DataContext="{Binding Editing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{DynamicResource rippleSize}" />
                <Grid Grid.Column="1" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="7" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.ColumnSpan="4" IsSnapToTickEnabled="True" Maximum="400" Minimum="50" Style="{StaticResource ModernSlider}" TickFrequency="5" Value="{Binding IndicatorSize}" />
                    <Rectangle Grid.Column="1" Width="2" Height="12" Margin="0,0,-1,0" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{DynamicResource TextSecondary}" IsHitTestVisible="False" />
                </Grid>
                <TextBlock Grid.Column="2" Style="{StaticResource HintText}" Text="{Binding IndicatorSize, StringFormat={}{0:0} px}" />
            </Grid>
            <Grid Margin="0,10,0,0" DataContext="{Binding Editing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{DynamicResource rippleDuration}" />
                <Grid Grid.Column="1" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="7" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.ColumnSpan="4" IsSnapToTickEnabled="True" Maximum="600" Minimum="200" Style="{StaticResource ModernSlider}" TickFrequency="25" Value="{Binding RippleDurationMs}" />
                    <Rectangle Grid.Column="1" Width="2" Height="12" Margin="0,0,-1,0" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{DynamicResource TextSecondary}" IsHitTestVisible="False" />
                </Grid>
                <TextBlock Grid.Column="2" Style="{StaticResource HintText}" Text="{Binding RippleDurationMs, StringFormat={}{0:0} ms}" />
            </Grid>
            <Grid Margin="0,10,0,0" DataContext="{Binding Editing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{DynamicResource easingStyle}" />
                <ComboBox
                    x:Name="EasingCombo"
                    Grid.Column="1"
                    Width="190"
                    Margin="12,0,0,0"
                    FontSize="12"
                    SelectionChanged="EasingCombo_SelectionChanged"
                    VerticalContentAlignment="Center" />
            </Grid>
            <Grid Margin="0,10,0,0" DataContext="{Binding Editing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{DynamicResource presetTheme}" />
                <ComboBox
                    x:Name="PresetCombo"
                    Grid.Column="1"
                    Width="190"
                    Margin="12,0,0,0"
                    FontSize="12"
                    SelectionChanged="PresetCombo_SelectionChanged"
                    VerticalContentAlignment="Center" />
            </Grid>

            <Grid Margin="0,10,0,0" DataContext="{Binding Editing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <Button Width="48" Height="24" HorizontalAlignment="Center" Background="{Binding MouseButtonSettings[Left].Color, Converter={StaticResource StringToBrush}, Mode=OneWay}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Click="Swatch_Click" Content="" Cursor="Hand" Tag="Left" ToolTip="{DynamicResource swatchLeftTip}" />
                    <TextBox x:Name="HexLeft" Width="76" Height="18" Margin="0,3,0,0" HorizontalAlignment="Center" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource TextPrimary}" KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus" Padding="0" Tag="Left" TextAlignment="Center" TextChanged="HexBox_TextChanged" VerticalContentAlignment="Center" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource tileLeft}" />
                    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding MouseButtonSettings[Left].IsEnabled}" Style="{StaticResource SwitchCheckBox}" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <Button Width="48" Height="24" HorizontalAlignment="Center" Background="{Binding MouseButtonSettings[Middle].Color, Converter={StaticResource StringToBrush}, Mode=OneWay}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Click="Swatch_Click" Content="" Cursor="Hand" Tag="Middle" ToolTip="{DynamicResource swatchMiddleTip}" />
                    <TextBox x:Name="HexMiddle" Width="76" Height="18" Margin="0,3,0,0" HorizontalAlignment="Center" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource TextPrimary}" KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus" Padding="0" Tag="Middle" TextAlignment="Center" TextChanged="HexBox_TextChanged" VerticalContentAlignment="Center" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource tileMiddle}" />
                    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding MouseButtonSettings[Middle].IsEnabled}" Style="{StaticResource SwitchCheckBox}" />
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <Button Width="48" Height="24" HorizontalAlignment="Center" Background="{Binding MouseButtonSettings[Right].Color, Converter={StaticResource StringToBrush}, Mode=OneWay}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Click="Swatch_Click" Content="" Cursor="Hand" Tag="Right" ToolTip="{DynamicResource swatchRightTip}" />
                    <TextBox x:Name="HexRight" Width="76" Height="18" Margin="0,3,0,0" HorizontalAlignment="Center" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource TextPrimary}" KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus" Padding="0" Tag="Right" TextAlignment="Center" TextChanged="HexBox_TextChanged" VerticalContentAlignment="Center" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource tileRight}" />
                    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding MouseButtonSettings[Right].IsEnabled}" Style="{StaticResource SwitchCheckBox}" />
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <Button Width="48" Height="24" HorizontalAlignment="Center" Background="{Binding MouseButtonSettings[XButton1].Color, Converter={StaticResource StringToBrush}, Mode=OneWay}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Click="Swatch_Click" Content="" Cursor="Hand" Tag="XButton1" ToolTip="{DynamicResource swatchX1Tip}" />
                    <TextBox x:Name="HexX1" Width="76" Height="18" Margin="0,3,0,0" HorizontalAlignment="Center" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource TextPrimary}" KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus" Padding="0" Tag="XButton1" TextAlignment="Center" TextChanged="HexBox_TextChanged" VerticalContentAlignment="Center" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimary}" Text="X1" />
                    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding MouseButtonSettings[XButton1].IsEnabled}" Style="{StaticResource SwitchCheckBox}" />
                </StackPanel>
                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <Button Width="48" Height="24" HorizontalAlignment="Center" Background="{Binding MouseButtonSettings[XButton2].Color, Converter={StaticResource StringToBrush}, Mode=OneWay}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Click="Swatch_Click" Content="" Cursor="Hand" Tag="XButton2" ToolTip="{DynamicResource swatchX2Tip}" />
                    <TextBox x:Name="HexX2" Width="76" Height="18" Margin="0,3,0,0" HorizontalAlignment="Center" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource TextPrimary}" KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus" Padding="0" Tag="XButton2" TextAlignment="Center" TextChanged="HexBox_TextChanged" VerticalContentAlignment="Center" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimary}" Text="X2" />
                    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding MouseButtonSettings[XButton2].IsEnabled}" Style="{StaticResource SwitchCheckBox}" />
                </StackPanel>
            </Grid>
            <Separator Margin="0,14" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="{DynamicResource secHoverDot}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" Style="{StaticResource HintText}" Text="{DynamicResource enableLabel}" />
                    <CheckBox IsChecked="{Binding Editing.EnableHoverDot}" Style="{StaticResource SwitchCheckBox}" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,4,0,0" DataContext="{Binding Editing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{DynamicResource hoverDotSize}" />
                <Grid Grid.Column="1" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="7*" />
                        <ColumnDefinition Width="7" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.ColumnSpan="4" IsSnapToTickEnabled="True" Maximum="200" Minimum="20" Style="{StaticResource ModernSlider}" TickFrequency="5" Value="{Binding HoverDotSize}" />
                    <Rectangle Grid.Column="1" Width="2" Height="12" Margin="0,0,-1,0" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{DynamicResource TextSecondary}" IsHitTestVisible="False" />
                </Grid>
                <TextBlock Grid.Column="2" Margin="0,0,12,0" Style="{StaticResource HintText}" Text="{Binding HoverDotSize, StringFormat={}{0:0} px}" />
                <Button Grid.Column="3" Width="48" Height="24" Margin="0,0,8,0" Background="{Binding HoverDotFill, Converter={StaticResource StringToBrush}, Mode=OneWay}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Click="Swatch_Click" Content="" Cursor="Hand" Tag="HoverDotFill" ToolTip="{DynamicResource swatchDotTip}" />
                <TextBox x:Name="HexDot" Grid.Column="4" Width="76" Height="20" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource TextPrimary}" KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus" Padding="0" Tag="HoverDotFill" TextAlignment="Center" TextChanged="HexBox_TextChanged" VerticalContentAlignment="Center" />
                <TextBlock Grid.Column="5" Style="{StaticResource FieldLabel}" Text="{DynamicResource colorLabel}" VerticalAlignment="Center" />
            </Grid>
            <Separator Margin="0,14" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="{DynamicResource secSilence}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" Style="{StaticResource HintText}" Text="{DynamicResource enableSilence}" />
                    <CheckBox IsChecked="{Binding Setting.SilenceEnabled}" Style="{StaticResource SwitchCheckBox}" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource HintText}" Text="{DynamicResource silenceMasterHint}" />
            <WrapPanel Margin="0,8,0,0" Orientation="Horizontal">
                <CheckBox IsChecked="{Binding Setting.FullscreenHide}" Style="{StaticResource SwitchCheckBox}" VerticalAlignment="Center" />
                <TextBlock Margin="8,0,0,0" Style="{StaticResource FieldLabel}" Text="{DynamicResource fullscreenHide}" VerticalAlignment="Center" />
                <TextBlock Margin="12,0,0,0" Style="{StaticResource HintText}" Text="{DynamicResource fullscreenHideHint}" VerticalAlignment="Center" />
            </WrapPanel>
            <WrapPanel Margin="0,10,0,0" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource processSilence}" VerticalAlignment="Center" />
                <TextBlock Margin="12,0,0,0" Style="{StaticResource HintText}" Text="{DynamicResource processSilenceHint}" VerticalAlignment="Center" />
            </WrapPanel>
            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ProcessList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,8,8" Padding="12,4" Background="{DynamicResource ChipBg}" BorderBrush="{DynamicResource ChipBorder}" BorderThickness="1" CornerRadius="14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextPrimary}" Text="{Binding}" />
                                <Button Margin="6,0,0,0" Click="ChipRemove_Click" Style="{StaticResource ChipCloseButton}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Margin="0,4,0,0" Orientation="Horizontal">
                <TextBox x:Name="AddProcessBox" Width="220" KeyDown="AddProcessBox_KeyDown" Style="{StaticResource TextInput}" />
                <Button Margin="8,0,0,0" Click="AddProcess_Click" Content="{DynamicResource addButton}" Style="{StaticResource GhostButton}" />
                <Button Margin="8,0,0,0" Click="BrowseProcess_Click" Content="{DynamicResource browseButton}" Style="{StaticResource GhostButton}" />
                <Button x:Name="CaptureButton" Margin="8,0,0,0" Click="CaptureForeground_Click" Content="{DynamicResource captureStart}" Style="{StaticResource GhostButton}" ToolTip="{DynamicResource captureHint}" />
                <TextBlock x:Name="CaptureHint" Margin="0,8,0,0" Foreground="{DynamicResource Danger}" Style="{StaticResource HintText}" Text="{DynamicResource captureHint}" VerticalAlignment="Center" Visibility="Collapsed" />
            </WrapPanel>
            <Separator Margin="0,14" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource secGeneral}" />
            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource languageLabel}" VerticalAlignment="Center" />
                <ComboBox x:Name="LanguageCombo" Width="190" Margin="12,0,0,0" FontSize="12" SelectionChanged="LanguageCombo_SelectionChanged" VerticalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                <CheckBox IsChecked="{Binding AutoStart}" Style="{StaticResource SwitchCheckBox}" VerticalAlignment="Center" />
                <TextBlock Margin="8,0,0,0" Style="{StaticResource FieldLabel}" Text="{DynamicResource autoStartLabel}" VerticalAlignment="Center" />
            </StackPanel>
            <WrapPanel Margin="0,10,0,0" Orientation="Horizontal">
                <Button Click="Export_Click" Content="{DynamicResource exportButton}" Style="{StaticResource GhostButton}" />
                <Button Margin="8,0,0,0" Click="Import_Click" Content="{DynamicResource importButton}" Style="{StaticResource GhostButton}" />
                <Button Margin="8,0,0,0" Click="ResetDefault_Click" Content="{DynamicResource resetButton}" Style="{StaticResource GhostButton}" />
            </WrapPanel>
            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                <TextBlock x:Name="VersionText" Style="{StaticResource HintText}" Text="ClickShow" />
                <TextBlock x:Name="LblNewVersion" Margin="12,0,0,0" FontWeight="Bold" Cursor="Hand" Foreground="{DynamicResource Danger}" MouseLeftButtonUp="LblNewVersion_Click" Style="{StaticResource HintText}" Text="{DynamicResource updateAvailable}" TextDecorations="Underline" Visibility="Collapsed" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
