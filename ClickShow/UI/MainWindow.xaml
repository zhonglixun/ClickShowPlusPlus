<Window
    x:Class="ClickShow.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ClickShow"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:utility="clr-namespace:ClickShow.Utility"
    Title="ClickShow 设置"
    Width="580"
    SizeToContent="Height"
    Background="{DynamicResource Bg}"
    MinHeight="400"
    ResizeMode="CanMinimize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <utility:StringToColorConverter x:Key="StringToColor" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,12,18,18">

            <!--  配置方案  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="配置方案" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ModeSystemRadio" Checked="ModeRadio_Checked" Content="跟随系统" GroupName="Mode" IsChecked="True" Style="{StaticResource PillRadio}" Tag="System" />
                <RadioButton x:Name="ModeLightRadio" Margin="8,0,0,0" Checked="ModeRadio_Checked" Content="始终浅色" GroupName="Mode" Style="{StaticResource PillRadio}" Tag="Light" />
                <RadioButton x:Name="ModeDarkRadio" Margin="8,0,0,0" Checked="ModeRadio_Checked" Content="始终深色" GroupName="Mode" Style="{StaticResource PillRadio}" Tag="Dark" />
            </StackPanel>
            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="正在编辑" />
                <RadioButton x:Name="EditLightRadio" Margin="10,0,0,0" Checked="EditRadio_Checked" Content="浅色配置" GroupName="Edit" IsChecked="True" Style="{StaticResource PillRadio}" Tag="Light" />
                <RadioButton x:Name="EditDarkRadio" Margin="8,0,0,0" Checked="EditRadio_Checked" Content="深色配置" GroupName="Edit" Style="{StaticResource PillRadio}" Tag="Dark" />
                <TextBlock Margin="12,0,0,0" Style="{StaticResource HintText}" Text="跟随系统时两套外观都生效，在此切换要编辑哪套；静默等行为设置两套共用" />
            </StackPanel>
            <Separator Margin="0,14" />

            <!--  点击波纹  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="点击波纹" />
                <CheckBox Grid.Column="1" IsChecked="{Binding Editing.EnableClickCircle}" Style="{StaticResource SwitchCheckBox}" />
            </Grid>
            <Border Height="170" Style="{StaticResource Card}">
                <Grid x:Name="PreviewArea" Background="Transparent" Cursor="Cross" MouseDown="PreviewArea_MouseDown">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Style="{StaticResource HintText}" Text="分别用左键 / 中键 / 右键 / 侧键点击，预览对应颜色波纹" />
                </Grid>
            </Border>
            <Grid Margin="0,10,0,0" DataContext="{Binding Editing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="波纹大小" />
                <Slider Grid.Column="1" Margin="12,0" IsSnapToTickEnabled="True" Maximum="400" Minimum="50" Style="{StaticResource ModernSlider}" TickFrequency="5" Value="{Binding IndicatorSize}" />
                <TextBlock Grid.Column="2" Style="{StaticResource HintText}" Text="{Binding IndicatorSize, StringFormat={}{0:0} px}" />
            </Grid>

            <Grid Margin="0,10,0,0" DataContext="{Binding Editing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <xctk:ColorPicker Width="48" Height="26" HorizontalAlignment="Center" DisplayColorAndName="False" SelectedColor="{Binding MouseButtonSettings[Left].Color, Converter={StaticResource StringToColor}, UpdateSourceTrigger=PropertyChanged}" ShowAvailableColors="False" ShowRecentColors="False" ShowStandardColors="False" ShowTabHeaders="False" UsingAlphaChannel="True" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimary}" Text="左键" />
                    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding MouseButtonSettings[Left].IsEnabled}" Style="{StaticResource SwitchCheckBox}" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <xctk:ColorPicker Width="48" Height="26" HorizontalAlignment="Center" DisplayColorAndName="False" SelectedColor="{Binding MouseButtonSettings[Middle].Color, Converter={StaticResource StringToColor}, UpdateSourceTrigger=PropertyChanged}" ShowAvailableColors="False" ShowRecentColors="False" ShowStandardColors="False" ShowTabHeaders="False" UsingAlphaChannel="True" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimary}" Text="中键" />
                    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding MouseButtonSettings[Middle].IsEnabled}" Style="{StaticResource SwitchCheckBox}" />
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <xctk:ColorPicker Width="48" Height="26" HorizontalAlignment="Center" DisplayColorAndName="False" SelectedColor="{Binding MouseButtonSettings[Right].Color, Converter={StaticResource StringToColor}, UpdateSourceTrigger=PropertyChanged}" ShowAvailableColors="False" ShowRecentColors="False" ShowStandardColors="False" ShowTabHeaders="False" UsingAlphaChannel="True" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimary}" Text="右键" />
                    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding MouseButtonSettings[Right].IsEnabled}" Style="{StaticResource SwitchCheckBox}" />
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <xctk:ColorPicker Width="48" Height="26" HorizontalAlignment="Center" DisplayColorAndName="False" SelectedColor="{Binding MouseButtonSettings[XButton1].Color, Converter={StaticResource StringToColor}, UpdateSourceTrigger=PropertyChanged}" ShowAvailableColors="False" ShowRecentColors="False" ShowStandardColors="False" ShowTabHeaders="False" UsingAlphaChannel="True" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimary}" Text="X1" />
                    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding MouseButtonSettings[XButton1].IsEnabled}" Style="{StaticResource SwitchCheckBox}" />
                </StackPanel>
                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <xctk:ColorPicker Width="48" Height="26" HorizontalAlignment="Center" DisplayColorAndName="False" SelectedColor="{Binding MouseButtonSettings[XButton2].Color, Converter={StaticResource StringToColor}, UpdateSourceTrigger=PropertyChanged}" ShowAvailableColors="False" ShowRecentColors="False" ShowStandardColors="False" ShowTabHeaders="False" UsingAlphaChannel="True" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimary}" Text="X2" />
                    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding MouseButtonSettings[XButton2].IsEnabled}" Style="{StaticResource SwitchCheckBox}" />
                </StackPanel>
            </Grid>
            <Separator Margin="0,14" />

            <!--  鼠标浮标  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="鼠标浮标" />
                <CheckBox Grid.Column="1" IsChecked="{Binding Editing.EnableHoverDot}" Style="{StaticResource SwitchCheckBox}" />
            </Grid>
            <Grid Margin="0,4,0,0" DataContext="{Binding Editing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="浮标大小" />
                <Slider Grid.Column="1" Margin="12,0" IsSnapToTickEnabled="True" Maximum="200" Minimum="20" Style="{StaticResource ModernSlider}" TickFrequency="5" Value="{Binding HoverDotSize}" />
                <TextBlock Grid.Column="2" Margin="0,0,12,0" Style="{StaticResource HintText}" Text="{Binding HoverDotSize, StringFormat={}{0:0} px}" />
                <TextBlock Grid.Column="3" Margin="0,0,8,0" Style="{StaticResource FieldLabel}" Text="颜色" />
                <xctk:ColorPicker Grid.Column="4" Width="48" Height="26" DisplayColorAndName="False" SelectedColor="{Binding HoverDotFill, Converter={StaticResource StringToColor}, UpdateSourceTrigger=PropertyChanged}" ShowAvailableColors="False" ShowRecentColors="False" ShowStandardColors="False" ShowTabHeaders="False" UsingAlphaChannel="True" />
            </Grid>
            <Separator Margin="0,14" />

            <!--  静默  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="静默" />
                <CheckBox Grid.Column="1" IsChecked="{Binding Setting.SilenceEnabled}" Style="{StaticResource SwitchCheckBox}" />
            </Grid>
            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                <CheckBox IsChecked="{Binding Setting.FullscreenHide}" Style="{StaticResource SwitchCheckBox}" />
                <TextBlock Margin="8,0,0,0" Style="{StaticResource FieldLabel}" Text="全屏自动隐藏" />
                <TextBlock Margin="12,0,0,0" Style="{StaticResource HintText}" Text="前台窗口铺满显示器时不显示特效" />
            </StackPanel>
            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="指定程序静默" />
                <TextBlock Margin="12,0,0,0" Style="{StaticResource HintText}" Text="列表中的程序在前台时始终隐藏特效（不限全屏），两套外观共用" />
            </StackPanel>
            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ProcessList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,8,8" Padding="12,4" Background="{DynamicResource ChipBg}" BorderBrush="{DynamicResource ChipBorder}" BorderThickness="1" CornerRadius="14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextPrimary}" Text="{Binding}" />
                                <Button Margin="6,0,0,0" Click="ChipRemove_Click" Style="{StaticResource ChipCloseButton}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                <TextBox x:Name="AddProcessBox" Width="220" KeyDown="AddProcessBox_KeyDown" Style="{StaticResource TextInput}" />
                <Button Margin="8,0,0,0" Click="AddProcess_Click" Content="添加" Style="{StaticResource GhostButton}" />
                <Button Margin="8,0,0,0" Click="BrowseProcess_Click" Content="浏览..." Style="{StaticResource GhostButton}" />
                <Button Margin="8,0,0,0" Click="CaptureForeground_Click" Content="抓取前台程序" Style="{StaticResource GhostButton}" />
            </StackPanel>
            <Separator Margin="0,14" />

            <!--  通用  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="通用" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding AutoStart}" Style="{StaticResource SwitchCheckBox}" />
                    <TextBlock Margin="8,0,0,0" Style="{StaticResource FieldLabel}" Text="开机自启" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Click="Export_Click" Content="导出配置" Style="{StaticResource GhostButton}" />
                    <Button Margin="8,0,0,0" Click="Import_Click" Content="导入配置" Style="{StaticResource GhostButton}" />
                    <Button Margin="8,0,0,0" Click="ResetDefault_Click" Content="恢复默认设置" Style="{StaticResource GhostButton}" />
                </StackPanel>
            </Grid>
            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                <TextBlock x:Name="VersionText" Style="{StaticResource HintText}" Text="ClickShow" />
                <TextBlock x:Name="LblNewVersion" Margin="12,0,0,0" FontWeight="Bold" Foreground="{DynamicResource Danger}" Style="{StaticResource HintText}" Text="已有新版本!" Visibility="Collapsed" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
